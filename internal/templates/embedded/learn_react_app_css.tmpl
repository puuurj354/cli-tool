/* ================================================================
   React Playground — Dark theme with sidebar layout
   ================================================================ */

:root {
  --bg-primary: #0f0f13;
  --bg-secondary: #16161d;
  --bg-card: #1c1c27;
  --bg-hover: #24243a;
  --bg-active: #2d2d4a;
  --accent: #6c63ff;
  --accent-hover: #7f78ff;
  --accent-glow: rgba(108, 99, 255, 0.15);
  --text-primary: #e4e4ef;
  --text-secondary: #888899;
  --text-muted: #555566;
  --border: #2a2a3a;
  --error-bg: #2a1a1a;
  --error-border: #ff4444;
  --success: #44dd88;
  --warning: #ffaa33;
  --radius: 10px;
  --sidebar-width: 300px;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.6;
  min-height: 100vh;
}

code, pre {
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 0.9em;
}

code {
  background: var(--bg-hover);
  padding: 2px 6px;
  border-radius: 4px;
  color: var(--accent);
}

pre {
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px;
  overflow-x: auto;
  line-height: 1.5;
}

button {
  cursor: pointer;
  font-family: inherit;
}

/* ---- Layout ---- */

.app-layout {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* ---- Sidebar ---- */

.sidebar {
  width: var(--sidebar-width);
  min-width: var(--sidebar-width);
  background: var(--bg-secondary);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sidebar-header {
  padding: 20px;
  border-bottom: 1px solid var(--border);
}

.sidebar-header h1 {
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 4px;
}

.badge {
  display: inline-block;
  font-size: 0.75rem;
  background: var(--accent-glow);
  color: var(--accent);
  padding: 2px 10px;
  border-radius: 99px;
  font-weight: 600;
}

.experiment-list {
  flex: 1;
  overflow-y: auto;
  padding: 8px;
}

.experiment-item {
  display: block;
  width: 100%;
  text-align: left;
  background: transparent;
  border: none;
  color: var(--text-primary);
  padding: 12px 14px;
  border-radius: 8px;
  margin-bottom: 2px;
  transition: background 0.15s, transform 0.1s;
}

.experiment-item:hover {
  background: var(--bg-hover);
}

.experiment-item.active {
  background: var(--bg-active);
  border-left: 3px solid var(--accent);
}

.experiment-title {
  display: block;
  font-weight: 600;
  font-size: 0.9rem;
}

.experiment-desc {
  display: block;
  font-size: 0.75rem;
  color: var(--text-secondary);
  margin-top: 2px;
}

.sidebar-footer {
  padding: 16px;
  border-top: 1px solid var(--border);
  font-size: 0.78rem;
  color: var(--text-muted);
  line-height: 1.5;
}

.sidebar-footer p + p {
  margin-top: 4px;
}

/* ---- Main Content ---- */

.main-content {
  flex: 1;
  overflow-y: auto;
  padding: 32px 40px;
  background: var(--bg-primary);
}

.experiment-header {
  margin-bottom: 28px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
}

.experiment-header h2 {
  font-size: 1.6rem;
  font-weight: 700;
  margin-bottom: 6px;
}

.experiment-header p {
  color: var(--text-secondary);
  font-size: 0.95rem;
}

.file-badge {
  display: inline-block;
  margin-top: 8px;
  font-size: 0.75rem;
  color: var(--text-muted);
  background: var(--bg-card);
  padding: 3px 10px;
  border-radius: 6px;
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
}

.experiment-body {
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ---- Error Card ---- */

.error-card {
  background: var(--error-bg);
  border: 1px solid var(--error-border);
  border-radius: var(--radius);
  padding: 24px;
}

.error-card h3 {
  margin-bottom: 12px;
  color: var(--error-border);
}

.error-card pre {
  background: var(--bg-primary);
  margin-bottom: 16px;
}

.error-card button {
  background: var(--error-border);
  color: #fff;
  border: none;
  padding: 8px 20px;
  border-radius: 6px;
  font-weight: 600;
  transition: opacity 0.15s;
}

.error-card button:hover {
  opacity: 0.85;
}

/* ---- Empty State ---- */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  text-align: center;
  padding: 40px;
}

.empty-state h1 {
  margin-bottom: 16px;
}

.empty-state p {
  color: var(--text-secondary);
  margin-bottom: 8px;
}

.empty-state pre {
  text-align: left;
  margin-top: 20px;
  max-width: 500px;
}

/* ---- Shared experiment styles ---- */

.demo-section {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  margin-bottom: 20px;
}

.demo-section h3 {
  font-size: 1rem;
  margin-bottom: 12px;
  color: var(--accent);
}

.demo-section + .demo-section {
  margin-top: 16px;
}

.demo-row {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
}

.btn {
  background: var(--accent);
  color: #fff;
  border: none;
  padding: 8px 18px;
  border-radius: 6px;
  font-size: 0.9rem;
  font-weight: 600;
  transition: background 0.15s, transform 0.1s;
}

.btn:hover {
  background: var(--accent-hover);
}

.btn:active {
  transform: scale(0.97);
}

.btn-outline {
  background: transparent;
  border: 1px solid var(--accent);
  color: var(--accent);
}

.btn-outline:hover {
  background: var(--accent-glow);
}

.btn-danger {
  background: var(--error-border);
}

.btn-danger:hover {
  background: #ff6666;
}

.input {
  background: var(--bg-primary);
  border: 1px solid var(--border);
  color: var(--text-primary);
  padding: 8px 14px;
  border-radius: 6px;
  font-size: 0.9rem;
  font-family: inherit;
  outline: none;
  transition: border-color 0.15s;
}

.input:focus {
  border-color: var(--accent);
}

.tag {
  display: inline-block;
  background: var(--bg-hover);
  color: var(--text-secondary);
  padding: 4px 10px;
  border-radius: 99px;
  font-size: 0.8rem;
  margin: 2px;
}

.hint {
  font-size: 0.8rem;
  color: var(--text-muted);
  margin-top: 8px;
}

.output {
  background: var(--bg-primary);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 12px 16px;
  margin-top: 12px;
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 0.85rem;
  color: var(--success);
  white-space: pre-wrap;
}
