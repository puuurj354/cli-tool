/**
 * Experiment 08: Context
 *
 * Learn: createContext, Provider, useContext — global state without prop drilling.
 */

import { createContext, useContext, useState, type ReactNode } from 'react'

export const title = 'Context API'
export const description = 'Shared state without prop drilling using createContext'

/* ---- Theme Context ---- */

type Theme = 'dark' | 'light' | 'blue'

interface ThemeContextValue {
  theme: Theme
  setTheme: (t: Theme) => void
}

const ThemeContext = createContext<ThemeContextValue | null>(null)

/** Defensive hook — throws if used outside provider */
function useTheme(): ThemeContextValue {
  const ctx = useContext(ThemeContext)
  if (!ctx) {
    throw new Error('useTheme must be used inside <ThemeProvider>')
  }
  return ctx
}

function ThemeProvider({ children }: { children: ReactNode }) {
  const [theme, setTheme] = useState<Theme>('dark')
  return (
    <ThemeContext.Provider value={{ theme, setTheme }}>
      {children}
    </ThemeContext.Provider>
  )
}

/* ---- Deeply Nested Component (no prop drilling!) ---- */

function ThemePicker() {
  const { theme, setTheme } = useTheme()
  const themes: Theme[] = ['dark', 'light', 'blue']

  return (
    <div className="demo-row" style={{ marginBottom: 12 }}>
      {themes.map((t) => (
        <button
          key={t}
          className={`btn ${t === theme ? '' : 'btn-outline'}`}
          onClick={() => setTheme(t)}
        >
          {t === 'dark' ? '🌙' : t === 'light' ? '☀️' : '💎'} {t}
        </button>
      ))}
    </div>
  )
}

const themeStyles: Record<Theme, React.CSSProperties> = {
  dark:  { background: '#1c1c27', color: '#e4e4ef', border: '1px solid #2a2a3a' },
  light: { background: '#f5f5f5', color: '#1a1a2e', border: '1px solid #ddd' },
  blue:  { background: '#1a2744', color: '#c9d9f0', border: '1px solid #2c4a7c' },
}

function ThemedCard() {
  const { theme } = useTheme()
  return (
    <div style={{ ...themeStyles[theme], padding: 20, borderRadius: 10 }}>
      <h4>I'm a themed card!</h4>
      <p>Current theme: <strong>{theme}</strong></p>
      <p style={{ fontSize: '0.85rem', opacity: 0.7 }}>
        This component reads the theme via <code>useTheme()</code> — no props passed down.
      </p>
    </div>
  )
}

function Header() {
  const { theme } = useTheme()
  return (
    <div style={{
      ...themeStyles[theme],
      padding: '10px 16px',
      borderRadius: 8,
      marginBottom: 12,
      display: 'flex',
      justifyContent: 'space-between',
      alignItems: 'center',
    }}>
      <span>🧪 App Header</span>
      <span className="tag">theme: {theme}</span>
    </div>
  )
}

/* ---- Counter Context (second context example) ---- */

interface CounterContextValue {
  count: number
  increment: () => void
  decrement: () => void
}

const CounterContext = createContext<CounterContextValue | null>(null)

function useCounter() {
  const ctx = useContext(CounterContext)
  if (!ctx) throw new Error('useCounter must be used inside <CounterProvider>')
  return ctx
}

function CounterProvider({ children }: { children: ReactNode }) {
  const [count, setCount] = useState(0)
  return (
    <CounterContext.Provider value={{
      count,
      increment: () => setCount((c) => c + 1),
      decrement: () => setCount((c) => c - 1),
    }}>
      {children}
    </CounterContext.Provider>
  )
}

function CounterDisplay() {
  const { count } = useCounter()
  return <span style={{ fontSize: '1.5rem', fontWeight: 700 }}>{count}</span>
}

function CounterControls() {
  const { increment, decrement } = useCounter()
  return (
    <div className="demo-row">
      <button className="btn" onClick={decrement}>−</button>
      <CounterDisplay />
      <button className="btn" onClick={increment}>+</button>
    </div>
  )
}

/* ---- Main Experiment ---- */
export default function ContextExperiment() {
  return (
    <>
      <ThemeProvider>
        <div className="demo-section">
          <h3>🎨 Theme Context</h3>
          <ThemePicker />
          <Header />
          <ThemedCard />
          <p className="hint" style={{ marginTop: 12 }}>
            💡 The <code>ThemePicker</code>, <code>Header</code>, and <code>ThemedCard</code>
            are separate components that share theme state via Context — zero prop drilling.
          </p>
        </div>
      </ThemeProvider>

      <CounterProvider>
        <div className="demo-section">
          <h3>🔢 Counter Context</h3>
          <CounterControls />
          <p className="hint" style={{ marginTop: 12 }}>
            💡 <code>CounterDisplay</code> and <code>CounterControls</code> share the same count
            state without passing it through props.
          </p>
        </div>
      </CounterProvider>
    </>
  )
}
