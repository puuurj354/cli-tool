package main

import (
	"fmt"
	"sync"
	"time"
)

// Job represents a unit of work
type Job struct {
	ID      int
	Payload string
}

// Result represents the output of a job
type Result struct {
	JobID  int
	Output string
	Error  error
}

// worker picks jobs from the jobsCh channel, processes them, and puts results in resultsCh.
// Defensive: always calls wg.Done() even if job processing panics.
func worker(id int, jobsCh <-chan Job, resultsCh chan<- Result, wg *sync.WaitGroup) {
	defer wg.Done()
	for job := range jobsCh {
		// Simulate processing time
		time.Sleep(10 * time.Millisecond)
		resultsCh <- Result{
			JobID:  job.ID,
			Output: fmt.Sprintf("worker-%d processed job-%d: %s", id, job.ID, job.Payload),
		}
	}
}

func main() {
	const numWorkers = 3
	const numJobs = 9

	jobsCh := make(chan Job, numJobs)
	resultsCh := make(chan Result, numJobs)

	// Start workers
	var wg sync.WaitGroup
	for w := 1; w <= numWorkers; w++ {
		wg.Add(1)
		go worker(w, jobsCh, resultsCh, &wg)
	}

	// Send jobs
	for j := 1; j <= numJobs; j++ {
		jobsCh <- Job{ID: j, Payload: fmt.Sprintf("data-%d", j)}
	}
	close(jobsCh) // Signal workers: no more jobs

	// Wait for all workers to finish then close results
	go func() {
		wg.Wait()
		close(resultsCh)
	}()

	// Collect results
	for result := range resultsCh {
		fmt.Println(result.Output)
	}

	fmt.Println("All jobs completed!")
}
